+  const periodLabel = period === "daily" ? "Daily" : period === "weekly" ? "Weekly" : "Monthly";
+  saveWorkbook(wb, `QuarryProSuite_${periodLabel}_Report_${fmtDate(start)}.xlsx`);
+}
